# Copy to .env and fill in real values before running `docker compose up`.

# Signs the JWTs issued by the backend. Use a long random string in any
# environment that isn't your own machine (e.g. `openssl rand -base64 48`).
JWT_SECRET=dev-only-secret-change-me-f5AB8E2d5awERSp

# OAuth client ID from https://console.cloud.google.com/apis/credentials
# (Web application type). Required for "Continue with Google" to work.
# Leave empty to disable Google sign-in — email/password auth still works.
GOOGLE_CLIENT_ID=

# Secret key from https://dashboard.stripe.com/apikeys — use a TEST mode key
# (sk_test_...) for local dev. Required for ordering physical badge cards.
STRIPE_SECRET_KEY=

# SMTP credentials for sending password-reset emails. Leave Host empty to
# disable sending (the reset link is still generated and logged in dev, but
# no email goes out). Port 587 + STARTTLS is standard; use 465 + SSL (set
# SMTP_USE_STARTTLS=false) if your provider requires implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@gymhub.com
SMTP_FROM_NAME=GymHub
SMTP_USE_STARTTLS=true
